# Staging environment for the Pi. Copy this file to staging.env at the repo
# root, fill it in, then send it over:
#
#    cp staging.env.example staging.env
#    scripts/staging/upload-env-var
#
# staging.env is gitignored. The upload writes it to /srv/wend/secrets.env on
# the Pi, where both systemd units read it -- that path is outside the deployed
# working tree, so it survives every deploy. Re-run the upload only when a
# value actually changes, not on each deploy. doc/how-to/cloud-storage.md has
# the whole story, including the one-off scripts/staging/setup needed the first
# time (the unit files gained an EnvironmentFile line for this).
#
# systemd parses the uploaded file, not bash. Keep every line plain:
#   NAME=value        yes
#   # a comment       yes, and blank lines too
#   export NAME=v     no -- systemd is not a shell
#   NAME=$(cmd)       no -- no command substitution, no backticks
# The upload script refuses to send a file that breaks any of those rules.
#
# Where the values come from: Cloudflare dashboard -> R2 -> Manage API tokens
# -> Create API token, "Object Read & Write", scoped to the wend buckets.

# Cloudflare account id. The S3 endpoint is derived from it:
#   https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# The R2 API token's access key id and secret. The Pi and your laptop can share
# one token -- it is the bucket, below, that keeps their objects apart.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Staging's own bucket. Unset it and the Pi falls back to local disk storage,
# which works but loses uploads whenever /srv/wend/app/backend/storage is
# cleared.
R2_BUCKET=wend-feedback-staging
