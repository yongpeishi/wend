# Local development environment. Copy this file to backend/.env and fill it in:
#
#    cp backend/.env.example backend/.env
#
# backend/.env is gitignored and is read at boot by dotenv-rails. This file --
# the .example -- is committed, so it is the one place the variable names are
# written down. Never put a real value in it.
#
# These four are the Cloudflare R2 credentials used to store feedback
# screenshots. Leave them blank and nothing breaks: the backend only selects
# the R2 service when R2_BUCKET is set, and otherwise falls back to local disk
# storage. That is the right state for CI and for a fresh clone.
#
# Where the values come from: Cloudflare dashboard -> R2 -> Manage API tokens
# -> Create API token, "Object Read & Write", scoped to the wend buckets. The
# full walkthrough is doc/how-to/cloud-storage.md.

# Cloudflare account id. The S3 endpoint is derived from it:
#   https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# The R2 API token's access key id and secret. The secret is shown once, when
# the token is created -- if you lost it, roll the token and re-issue.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Development uses its own bucket, so what you upload while poking at the app
# never lands in the bucket staging is showing people.
R2_BUCKET=wend-feedback-localhost
