source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.3", ">= 8.1.3.1"
# Use sqlite3 as the database for Active Record
gem "sqlite3", ">= 2.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# Build JSON APIs with ease [https://github.com/rails/jbuilder]
# gem "jbuilder"
# Use Redis adapter to run Action Cable in production
# gem "redis", ">= 4.0.1"

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
gem "bcrypt", "~> 3.1.7"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

# Use Rack CORS for handling Cross-Origin Resource Sharing (CORS), making cross-origin Ajax possible
gem "rack-cors"

# Authorization: plain policy objects plus the deny-by-default after_action hooks
# (verify_authorized / verify_policy_scoped) that make a missed check a test failure.
gem "pundit", "~> 2.5"

# Active Storage talks to Cloudflare R2 through its S3 service, which is why an
# AWS SDK appears in an app with nothing on AWS: R2 is S3-compatible, and this is
# the client that speaks that dialect. `require: false` because Active Storage
# loads it lazily, and only when the configured service is actually :r2 -- a
# checkout with no R2 credentials runs on the Disk service and never touches it.
gem "aws-sdk-s3", require: false

group :development, :test do
  # R2 credentials are per-machine, not per-repo, so they live in an untracked
  # backend/env/development.env (config/application.rb points dotenv there)
  # rather than in Rails credentials. Development-and-test only:
  # production takes its environment from the process that boots it, and a .env
  # file there would be a second, quieter source of truth for the same secrets.
  gem "dotenv-rails"

  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Audits gems for known security defects (use config/bundler-audit.yml to ignore issues)
  gem "bundler-audit", require: false

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false
end

gem "sorbet-static-and-runtime", "~> 0.6.13420", groups: [:development, :test]

gem "tapioca", "~> 0.19.2", groups: [:development, :test], require: false

gem "csv", "~> 3.3"
