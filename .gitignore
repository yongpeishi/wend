.DS_Store
node_modules/
.claude/worktrees/
doc/backlog/
temp-design-files/

# Environment files hold the Cloudflare R2 credentials — real secrets, never
# committed. The filled-in ones live in backend/env/ (development.env and
# staging.env, ignored there by backend/.gitignore); the env.example template
# next to them is committed and is the only place the variable names are
# written down. See doc/how-to/cloud-storage.md. These rules catch a stray
# dotfile anywhere else.
.env
.env.*
!.env.example

# a place to put wip notes (TASK_STATUS, TASK_END_SUMMARY, screenshots)
doc/worktree-notes/
# design-sync (claude.ai/design) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
