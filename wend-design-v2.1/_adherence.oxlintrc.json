{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/travel/**",
              "ui_kits/roadbook/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Atkinson Hyperlegible|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Atkinson Hyperlegible, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|disabled|focused|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, disabled, focused."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet|onDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|bordered|radius|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, bordered, radius, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:card|page|inverse)$/]",
        "message": "<Card> tone must be one of 'card' | 'page' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:card|media|screen)$/]",
        "message": "<Card> radius must be one of 'card' | 'media' | 'screen'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|focused|leading|trailing|hint|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, placeholder, focused, leading, trailing, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeepToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:kept|size|label|onToggle|key|ref|className|style|children)$/]",
        "message": "<KeepToggle> doesn't accept that prop. Declared props: kept, size, label, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|as|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: tone, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|strong|onDark|saved)$/]",
        "message": "<Label> tone must be one of 'muted' | 'strong' | 'onDark' | 'saved'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|showWordmark|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, showWordmark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|reversed)$/]",
        "message": "<Logo> variant must be one of 'primary' | 'reversed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlaceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|meta|note|kept|onToggle|key|ref|className|style|children)$/]",
        "message": "<PlaceCard> doesn't accept that prop. Declared props: name, meta, note, kept, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Placeholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|radius|caption|key|ref|className|style|children)$/]",
        "message": "<Placeholder> doesn't accept that prop. Declared props: height, radius, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='Placeholder'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:media|card|none)$/]",
        "message": "<Placeholder> radius must be one of 'media' | 'card' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|title|meta|state|onDark|trailing|key|ref|className|style|children)$/]",
        "message": "<TimeRow> doesn't accept that prop. Declared props: time, title, meta, state, onDark, trailing."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:decided|open|waiting|destination)$/]",
        "message": "<TimeRow> state must be one of 'decided' | 'open' | 'waiting' | 'destination'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Trail'] > JSXAttribute > JSXIdentifier[name!=/^(?:stops|labels|onDark|height|key|ref|className|style|children)$/]",
        "message": "<Trail> doesn't accept that prop. Declared props: stops, labels, onDark, height."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
