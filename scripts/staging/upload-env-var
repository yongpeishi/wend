#!/usr/bin/env bash
# Send the credentials in backend/env/staging.env to the Pi, without deploying.
#
#   scripts/staging/upload-env-var
#   scripts/staging/upload-env-var --yes    # don't ask before uploading
#
# scripts/staging/deploy already does this, idempotently, on every deploy. This
# is the same steps on their own, for when a value changes and there is no code
# to push -- a rolled token, a new bucket.
#
# What it does, and why none of it needs root, is in lib/secrets.sh.

source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib/secrets.sh"

for arg in "$@"; do
  case "$arg" in
    --yes|-y) ASSUME_YES=true ;;
    *)        die "unknown argument $arg" ;;
  esac
done

# Checked before anything that talks to the Pi, so the common mistake (running
# this in a checkout that has no staging.env yet) costs a sentence, not an ssh
# connection and a username prompt.
[ -f "$SECRETS_FILE" ] || die "no $SECRETS_FILE
    cp backend/env/env.example backend/env/staging.env, fill it in,
    then re-run this.
    See doc/how-to/cloud-storage.md."

secrets_validate || die "fix backend/env/staging.env and re-run"
secrets_describe

cd "$(git_root)"
require_pi_remote

echo
confirm "overwrite $(pi_ssh):$SECRETS_REMOTE with these ${#SECRETS_NAMES[@]} variable(s)?" \
  || die "nothing uploaded"

info "writing $SECRETS_REMOTE"
secrets_upload
ok "uploaded"

secrets_link

# --- make the services notice -----------------------------------------------
# Both readers -- dotenv at boot, and `EnvironmentFile` on a Pi whose units
# have it -- read the file once, at start. A running service is still holding
# the environment it booted with.

echo
if confirm "restart both services so they pick the new values up?"; then
  # One unit per call: the sudoers rule names each service on its own, so a
  # combined `systemctl restart a b` would be a command it doesn't recognise.
  for s in wend-backend.service wend-frontend.service; do
    info "restarting $s"
    pi_ssh_run "sudo -n systemctl restart $s"
  done
  pi_ssh_run "systemctl is-active wend-backend.service wend-frontend.service" || true
else
  warn "not restarted -- the services still have the old environment"
  info "restart them later with: scripts/staging/restart"
fi

echo
ok "done -- a deploy keeps the Pi in step from here, so re-run this only
     when you change a value and have no code to push"
