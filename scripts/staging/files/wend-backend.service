# Installed to /etc/systemd/system/ by scripts/staging/provision.
[Unit]
Description=wend staging: Rails API
Documentation=https://github.com/yongpeishi/wend/blob/main/scripts/staging/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wend
Group=wend
WorkingDirectory=/srv/wend/app
EnvironmentFile=/srv/wend/deploy.env
# Secrets (the Cloudflare R2 credentials) live in their own file, put there by
# scripts/staging/deploy and never in git. It is separate from deploy.env
# because `provision` rewrites that one from scratch on every run, which would
# silently destroy anything appended to it.
#
# This line is a second reader of that file, not the main one: installing a
# unit needs root, and a deploy must not. The deploy instead links
# backend/env/development.env at it, which dotenv-rails reads at boot -- so a
# collaborator without sudo can roll out a credential. This stays because it
# costs nothing, is the same file, and would keep R2 working if staging ever
# stopped running as RAILS_ENV=development (dotenv is a development gem).
# The leading `-` makes it optional, so a Pi that has never had secrets
# uploaded still boots -- the app then falls back to local disk storage.
EnvironmentFile=-/srv/wend/secrets.env
# The same entry point everyone uses locally, so staging can't drift from
# `scripts/start-dev`. It runs `bin/rails dev:prepare` before booting, which is
# where migrations and first-run seeding happen.
ExecStart=/srv/wend/app/scripts/start-backend
Restart=on-failure
RestartSec=5
# Files this writes (the sqlite database, logs, tmp) stay group-writable so a
# deploy running as logan or peishi can clear them out.
UMask=0002

[Install]
WantedBy=multi-user.target
