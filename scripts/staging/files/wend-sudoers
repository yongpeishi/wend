# Installed to /etc/sudoers.d/wend-staging by scripts/staging/provision.
#
# Deploys run as the person pushing, so they need to bounce the two services --
# and only those two. Nothing else here grants root.
Cmnd_Alias WEND_SERVICES = \
  /usr/bin/systemctl start wend-backend.service,   \
  /usr/bin/systemctl stop wend-backend.service,    \
  /usr/bin/systemctl restart wend-backend.service, \
  /usr/bin/systemctl start wend-frontend.service,  \
  /usr/bin/systemctl stop wend-frontend.service,   \
  /usr/bin/systemctl restart wend-frontend.service

%wend ALL=(root) NOPASSWD: WEND_SERVICES

# The database, the logs and the tmp files belong to the `wend` user, so
# resetting the database or opening a console has to happen as `wend`:
#
#   cd /srv/wend/app && sudo -u wend scripts/db-reset
#
# This grants nothing new. Anyone in this group can already push code that the
# services then run as `wend` -- that is what deploying is. `wend` owns nothing
# outside /srv/wend and cannot become root.
%wend ALL=(wend) NOPASSWD: ALL

# sudo replaces PATH with its own secure_path, which doesn't have the staging
# ruby and node on it -- `sudo -u wend scripts/db-reset` died on "env: ruby:
# No such file or directory". These two apply only when the command is being
# run *as* wend, and give it the same PATH and HOME the systemd units use.
Defaults>wend secure_path="/srv/wend/env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Defaults>wend always_set_home
